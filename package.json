{
  "name": "playwright-restful-booker-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "test:report": "playwright show-report",
    "test:allure": "playwright test && allure generate allure-results --clean -o allure-report",
    "report:allure": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.14.0",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  }
}
